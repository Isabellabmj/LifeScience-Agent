    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst CHUNK_SIZE = 1200;\nconst OVERLAP = 200;\nconst result = [];\n\nfunction splitLongText(text, maxLength) {\n  const pieces = [];\n  let remaining = text.trim();\n\n  while (remaining.length > maxLength) {\n    const candidate = remaining.slice(0, maxLength);\n\n    // Foretræk at dele ved en sætningsafslutning\n    let splitAt = Math.max(\n      candidate.lastIndexOf(\". \"),\n      candidate.lastIndexOf(\"? \"),\n      candidate.lastIndexOf(\"! \")\n    );\n\n    if (splitAt >= Math.floor(maxLength * 0.5)) {\n      splitAt += 1;\n    } else {\n      // Ellers del ved et mellemrum\n      splitAt = candidate.lastIndexOf(\" \");\n\n      if (splitAt < Math.floor(maxLength * 0.5)) {\n        splitAt = maxLength;\n      }\n    }\n\n    pieces.push(remaining.slice(0, splitAt).trim());\n    remaining = remaining.slice(splitAt).trim();\n  }\n\n  if (remaining) pieces.push(remaining);\n  return pieces;\n}\n\nfor (const item of items) {\n  const { text, source, subject } = item.json;\n\n  if (!text || !text.trim()) continue;\n\n  const paragraphs = text\n    .replace(/\\r\\n/g, \"\\n\")\n    .split(/\\n\\s*\\n/)\n    .map(p => p.replace(/\\s+/g, \" \").trim())\n    .filter(Boolean);\n\n  const segments = paragraphs.flatMap(p =>\n    splitLongText(p, CHUNK_SIZE - OVERLAP)\n  );\n\n  let current = \"\";\n  let chunkIndex = 0;\n\n  function addChunk(content) {\n    const cleaned = content.trim();\n    if (!cleaned) return;\n\n    result.push({\n      json: {\n        text: cleaned,\n        source,\n        subject,\n        chunkIndex,\n        chunkId: `${source.replace(/[^a-zA-Z0-9]/g, \"_\")}_${chunkIndex}`\n      }\n    });\n\n    chunkIndex++;\n  }\n\n  for (const segment of segments) {\n    const combined = current\n      ? current + \"\\n\\n\" + segment\n      : segment;\n\n    if (combined.length <= CHUNK_SIZE) {\n      current = combined;\n    } else {\n      addChunk(current);\n\n      const overlapText = current.slice(-OVERLAP);\n      const available = CHUNK_SIZE - segment.length - 2;\n      const safeOverlap = overlapText.slice(\n        -Math.max(0, available)\n      );\n\n      current = safeOverlap\n        ? safeOverlap + \"\\n\\n\" + segment\n        : segment;\n    }\n  }\n\n  addChunk(current);\n}\nconst tooLong = result.filter(item => item.json.text.length > CHUNK_SIZE);\n\nif (tooLong.length > 0) {\n  throw new Error(\n    `${tooLong.length} chunks er større end ${CHUNK_SIZE} tegn`\n  );\n}\n\nreturn result;\n"
      },
