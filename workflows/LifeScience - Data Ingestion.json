    {
      "parameters": {
        "jsCode": "// Hent embeddings fra OpenAI\nconst embeddings = $input.all();\n\n// Hent de chunks, der ikke allerede findes i Neo4j\nconst chunks = $(\"Code in JavaScript1\").all();\n\n// Kontroller at antallet stemmer\nif (embeddings.length !== chunks.length) {\n  throw new Error(\"Antallet af embeddings og chunks stemmer ikke.\");\n}\n\nreturn embeddings.map((item, index) => {\n\n  const chunk = chunks[index].json;\n  const embedding = item.json.data?.[0]?.embedding;\n\n  // Kontroller at embedding har den forventede størrelse\n  if (!Array.isArray(embedding) || embedding.length !== 1536) {\n    throw new Error(`Ugyldig embedding for chunk ${index}`);\n  }\n\n  return {\n    json: {\n      text: chunk.text,\n      source: chunk.source,\n      subject: chunk.subject,\n      chunkIndex: chunk.chunkIndex,\n      chunkId: chunk.chunkId,\n      embedding: embedding\n    }\n  };\n});"
      },
