        "jsCode": "// Hent de 45 chunks, der ikke findes i Neo4j\nconst filteredItems = $input.all();\n\nconst result = [];\n\nfor (let i = 0; i < filteredItems.length; i++) {\n\n  // Find det oprindelige chunk via n8n's item-linking\n  const originalChunk = $(\"Limit\").itemMatching(i).json;\n\n  result.push({\n    json: {\n      text: originalChunk.text,\n      source: originalChunk.source,\n      subject: originalChunk.subject,\n      chunkIndex: originalChunk.chunkIndex,\n      chunkId: originalChunk.chunkId\n    }\n  });\n}\n\nreturn result;"
