    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7474/db/neo4j/query/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "statement",
              "value": "MATCH (c:DocumentChunk) WHERE c.chunkIndex >= 20 RETURN c.text AS text, c.source AS source, c.chunkId AS chunkId ORDER BY c.chunkIndex LIMIT 5"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "id": "f36f5734-118b-499a-84c6-bf661c91a6dd",
      "name": "Neo4j - Get Document Chunks.",
      "credentials": {
        "httpBasicAuth": {
          "id": "nvYiqyKl3QYRZv1H",
          "name": "Neo4j - LifeScience-RAG"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Hent resultaterne fra Neo4j\nconst items = $input.all();\n\nconst result = [];\n\nfor (const item of items) {\n\n  // Neo4j returnerer data i et values-array\n  const rows = item.json.data?.values ?? [];\n\n  for (const row of rows) {\n\n    result.push({\n      json: {\n        text: row[0],\n        source: row[1],\n        chunkId: row[2]\n      }\n    });\n\n  }\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "360a53f9-12da-4bda-b0bc-326d345d0f22",
      "name": "Prepare Text for Graph",
      "executeOnce": true
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "You extract scientific concepts and relationships from analytical chemistry and microbiology texts.\n\nOnly extract relationships explicitly supported by the provided text.\n\nReturn valid JSON in this format:\n{\n  \"relationships\": [\n    {\n      \"source\": \"Spectrophotometry\",\n      \"relationship\": \"USED_IN\",\n      \"target\": \"Analytical Chemistry\"\n    }\n  ]\n}\n\nRules:\n- Extract at most 3 relationships per text.\n- Use short scientific concept names.\n- Use uppercase relationship types with underscores.\n- Do not invent relationships.\n- If no scientific relationships are found, return {\"relationships\":[]}.\n- Return JSON only."
            },
            {
              "content": "={{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ],
      "id": "7511b020-d72a-4d85-b9cd-bfb675968c1e",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "gE9cN9UBGAhgqK71",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n\n  // Hent AI'ens svar\n  let text = item.json.output?.[0]?.content?.[0]?.text;\n\n  if (!text) continue;\n\n  // Fjern ```json og ``` fra AI'ens svar\n  text = text\n    .replace(/```json\\s*/gi, \"\")\n    .replace(/```\\s*/g, \"\")\n    .trim();\n\n  // Omdan teksten til JSON\n  const data = JSON.parse(text);\n\n  // Gennemgå relationerne\n  for (const relation of data.relationships ?? []) {\n\n    results.push({\n      json: {\n        source: relation.source,\n        relationship: relation.relationship,\n        target: relation.target\n      }\n    });\n\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "id": "04997c85-f467-4edb-b217-3e5d78ee4a60",
      "name": "Prepare Graph Relationships"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7474/db/neo4j/query/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "statement",
              "value": "MERGE (a:ScientificConcept {name: $source}) MERGE (b:ScientificConcept {name: $target}) MERGE (a)-[r:RELATED_TO {type: $relationship}]->(b) RETURN a.name AS source, r.type AS relationship, b.name AS target"
            },
            {
              "name": "parameters",
              "value": "={{ {   source: $json.source,   relationship: $json.relationship,   target: $json.target } }}"
            }
          ]
        },
        "options": {}
      },
