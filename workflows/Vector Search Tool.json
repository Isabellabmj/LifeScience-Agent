              "name": "statement",
              "value": "CALL db.index.vector.queryNodes(   'document_chunk_vector_index',   5,   $embedding ) YIELD node, score RETURN   node.text AS text,   node.source AS source,   node.subject AS subject,   score ORDER BY score DESC"
