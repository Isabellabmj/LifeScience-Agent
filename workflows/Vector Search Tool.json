    {
      "parameters": {
        "jsCode": "// Hent resultatet fra Neo4j\nconst data = $input.first().json.data;\n\n// Hent kolonnenavne og resultater\nconst fields = data.fields;\nconst values = data.values;\n\n// Omdan resultaterne til læsbare dokumenter\nconst documents = values.map(row => {\n\n    const document = {};\n\n    fields.forEach((field, index) => {\n        document[field] = row[index];\n    });\n\n    return {\n        text: document.text,\n        source: document.source,\n        subject: document.subject,\n        score: document.score\n    };\n});\n\n// Send kun de relevante oplysninger videre\nreturn [{\n    json: {\n        documents: documents\n    }\n}];"
      },
