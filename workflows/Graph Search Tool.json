        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "statement",
              "value": "MATCH (a)-[r]->(b) WHERE (a:LifeScienceEntity OR a:Method OR a:Field OR a:ScientificConcept)   AND (b:LifeScienceEntity OR b:Method OR b:Field OR b:ScientificConcept)   AND (     toLower(a.name) CONTAINS toLower($searchTerm)     OR toLower(b.name) CONTAINS toLower($searchTerm)   ) RETURN   a.name AS concept,   coalesce(r.type, type(r)) AS relationship,   b.name AS relatedConcept LIMIT 10"
            },
            {
              "name": "parameters",
              "value": "={{ { searchTerm: $json.searchTerm } }}"
            }
          ]
        },
        "options": {}
      },
