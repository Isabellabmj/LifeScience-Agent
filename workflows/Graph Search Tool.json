    },
    {
      "parameters": {
        "jsCode": "// Hent resultatet fra Neo4j\nconst data = $input.first().json.data;\n\n// Hent kolonnenavne og resultater\nconst fields = data.fields;\nconst values = data.values;\n\n// Omdan hver række til et objekt\nconst relationships = values.map(row => {\n  const relationship = {};\n\n  fields.forEach((field, index) => {\n    relationship[field] = row[index];\n  });\n\n  return relationship;\n});\n\n// Send resultaterne videre til AI-agenten\nreturn [\n  {\n    json: {\n      relationships: relationships\n    }\n  }\n];"
      },
